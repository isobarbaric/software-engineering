{
  "name": "@isobarbaric/code-contracts",
  "version": "0.1.0",
  "description": "Deterministic code contracts for TypeScript and Python repositories.",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "code-contracts": "./bin/code-contracts.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "python",
    "README.md"
  ],
  "scripts": {
    "check": "node bin/code-contracts.js check",
    "lint": "eslint bin src tests && python3 -m compileall -q python",
    "test": "pnpm run test:eslint && pnpm run test:python",
    "test:eslint": "node --test",
    "test:python": "python3 -m unittest discover -s python/tests -p 'test_*.py'"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
